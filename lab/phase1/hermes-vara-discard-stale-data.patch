 #include "shm.h"
 
+bool bridge_claim(int semid)
+{
+    struct sembuf op = {0, -1, SEM_UNDO | IPC_NOWAIT};
+    return semop(semid, &op, 1) == 0;
+}
+
+void bridge_release(int semid)
+{
+    struct sembuf op = {0, 1, SEM_UNDO | IPC_NOWAIT};
+    semop(semid, &op, 1);
+}
+
+bool bridge_busy(int semid)
+{
+    /* An invalid semaphore is not permission to reuse the rings. */
+    return semctl(semid, 0, GETVAL) != 1;
+}
